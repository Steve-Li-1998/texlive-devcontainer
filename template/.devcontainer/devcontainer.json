{
  "name": "<PROJECT_NAME>",
  // Prebuilt dev image; <IMAGE> is the image repository without a tag
  "image": "<IMAGE>:dev",
  // Public, no login needed:
  // "image": "ghcr.io/steve-li-1998/texlive-devcontainer:dev",
  "remoteUser": "vscode",
  // Remap vscode's UID/GID to the host user's at startup (host UID may not be 1000)
  "updateRemoteUserUID": true,
  // rtex starts lualatex without -shell-escape; mermaid/plantuml/minted need it.
  // kpathsea reads texmf.cnf variables from the environment.
  "remoteEnv": {
    "shell_escape": "t"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        // Not on the Marketplace; install the .vsix baked into the image
        "/opt/rtex/realtime-tex.vsix",
        "james-yu.latex-workshop"
      ],
      "settings": {
        "realtimeTex.serverPath": "/usr/local/bin/rtex",
        "realtimeTex.texliveBin": "/usr/local/texlive/bin-current",
        // rtex is baked into the image; don't let the extension replace it
        "realtimeTex.updateCheck": "off",
        // rtex does the live preview; build with LaTeX Workshop only on demand
        "latex-workshop.latex.autoBuild.run": "never",
        // PDF and build files go to out/ next to the main .tex file
        "latex-workshop.latex.outDir": "%DIR%/out",
        // LuaLaTeX (plantuml.sty needs it); -shell-escape comes from /etc/LatexMk
        "latex-workshop.latex.tools": [
          {
            "name": "latexmk",
            "command": "latexmk",
            "args": ["-lualatex", "-synctex=1", "-interaction=nonstopmode", "-file-line-error", "-outdir=%OUTDIR%", "%DOC%"]
          }
        ],
        "latex-workshop.latex.recipes": [
          { "name": "latexmk (LuaLaTeX)", "tools": ["latexmk"] }
        ]
      }
    }
  }
}
